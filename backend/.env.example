# Copie este arquivo para ".env" (na raiz do projeto e em backend/) e preencha.

# Banco (rodando o backend fora do Docker, o host é localhost)
DATABASE_URL="postgresql://admin:senha123@localhost:5432/bndmet?schema=public"

# Servidor
PORT=3001
NODE_ENV=development

# Login do administrador (use um texto longo e aleatório)
JWT_SECRET=troque_por_um_texto_longo_e_aleatorio
JWT_EXPIRES_IN=24h

# Endereço do frontend
CORS_ORIGIN=http://localhost:3000

# E-mail (Gmail: use uma "senha de app"). Sem estes campos, o envio só aparece no console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
