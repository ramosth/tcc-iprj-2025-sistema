// backend > prisma > schema.prisma
// Versão v3-simples: 4 tabelas. Deve ficar igual a database/init/01-schema.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Uma linha por JSON recebido do dispositivo (POST /leituras).
// Campos de energia ficam nulos quando a leitura vem do protótipo físico.
model Leitura {
  id                 Int      @id @default(autoincrement())
  criadoEm           DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  evento             String   @default("ciclo") @db.VarChar(10) // "ciclo" | "energia"
  nivel              String   @db.VarChar(10) // "VERDE" | "AMARELO" | "VERMELHO"
  s                  Decimal? @db.Decimal(4, 2) // saturação relativa (0–1)
  p48                Decimal? @db.Decimal(7, 2) // mm, BNDMET
  p24                Decimal? @db.Decimal(7, 2) // mm, OpenWeatherMap
  p72                Decimal? @db.Decimal(7, 2) // mm, P48 + P24 (nulo se incompleto)
  p72Minimo          Decimal? @map("p72_minimo") @db.Decimal(7, 2) // mm, mínimo garantido (só se incompleto)
  p48DiasNulos       Int      @default(0) @map("p48_dias_nulos") @db.SmallInt // dias sem registro no BNDMET
  rede               Boolean?
  vbat               Decimal? @db.Decimal(4, 2) // V
  estadoBateria      String?  @map("estado_bateria") @db.VarChar(10) // NORMAL | BAIXA | CRITICA | FALHA
  sensorIndisponivel Boolean  @default(false) @map("sensor_indisponivel")
  p48Indisponivel    Boolean  @default(false) @map("p48_indisponivel")
  p24Indisponivel    Boolean  @default(false) @map("p24_indisponivel")
  chuvaIncompleta    Boolean  @default(false) @map("chuva_incompleta") // falta uma parcela ou um dia
  semDadosChuva      Boolean  @default(false) @map("sem_dados_chuva") // nenhuma parcela obtida
  p72Injetado        Boolean  @default(false) @map("p72_injetado")
  simulacao          Boolean  @default(false)
  eventos            Evento[]

  @@index([criadoEm])
  @@map("leituras")
}

// Registro de tudo o que gera aviso: nível subiu, mudança de energia e
// e-mails de alerta enviados pelo administrador.
model Evento {
  id              Int            @id @default(autoincrement())
  criadoEm        DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  tipo            String         @db.VarChar(20) // NIVEL_SUBIU | ENERGIA | ALERTA_MANUAL
  nivel           String?        @db.VarChar(10)
  descricao       String
  leituraId       Int?           @map("leitura_id")
  administradorId Int?           @map("administrador_id")
  destinatarios   Int            @default(0)
  enviados        Int            @default(0)
  falhas          Int            @default(0)
  leitura         Leitura?       @relation(fields: [leituraId], references: [id], onDelete: SetNull)
  administrador   Administrador? @relation(fields: [administradorId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
  @@map("eventos")
}

// Moradores cadastrados pela landing page ("Quero receber alertas").
model UsuarioBasico {
  id         Int      @id @default(autoincrement())
  nome       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(255)
  telefone   String?  @db.VarChar(20)
  localidade String?  @db.VarChar(100)
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@map("usuarios_basicos")
}

// Quem faz login no painel e envia os alertas.
model Administrador {
  id          Int       @id @default(autoincrement())
  nome        String    @db.VarChar(100)
  email       String    @unique @db.VarChar(255)
  senhaHash   String    @map("senha_hash") @db.VarChar(255)
  ativo       Boolean   @default(true)
  ultimoLogin DateTime? @map("ultimo_login") @db.Timestamptz(6)
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  eventos     Evento[]

  @@map("administradores")
}
